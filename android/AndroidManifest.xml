<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="it.rikyr.pannello">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- SHUTDOWN viene concesso solo con l'app in /system/priv-app (vedi LEGGIMI) -->
    <uses-permission android:name="android.permission.SHUTDOWN" />
    <!-- riavvio del debug USB quando adb resta "offline" dopo la ripresa del PC: si concede con pm grant -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- Jarvis: microfono e voce del tablet anche a schermo spento (servizio in primo piano, Wi-Fi sveglio) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Jarvis guarda con la telecamera posteriore, solo dopo il sì dell'utente (Fotocamera.java) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- modalità "chiamata" per la cancellazione dell'eco (Jarvis si può interrompere parlandogli sopra) -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <application
        android:label="Pannello PC"
        android:icon="@mipmap/icona"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true"
        android:name=".Applicazione"
        android:persistent="true"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">

        <activity
            android:name=".Pannello"
            android:screenOrientation="sensorLandscape"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:resumeWhilePausing="true"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|navigation|uiMode"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service android:name=".JarvisServizio" android:exported="false" />

        <receiver
            android:name=".Amministratore"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data android:name="android.app.device_admin" android:resource="@xml/amministratore" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
